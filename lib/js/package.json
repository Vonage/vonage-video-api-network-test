{
  "name": "@vonage/video-client-network-test",
  "version": "5.1.7",
  "description": "Precall network test for applications using the Vonage Video API platform.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build:js": "rm -rf dist && webpack --config webpack.config.mjs  --stats-error-details",
    "build:types": "tsc --project ./tsconfig.json",
    "build": "npm run build:js && npm run build:types",
    "test-setup": "node test/setup/setup.js",
    "test-teardown": "rm test/credentials.json",
    "karma": "karma start karma.conf.mjs",
    "karma:dist": "karma start karma.conf.dist.mjs",
    "karma:dist:esm": "karma start karma.conf.dist.esm.mjs",
    "test": "npm run test-setup && npm run karma && npm run test-teardown",
    "test:dist": "npm run build && npm run karma:dist && npm run karma:dist:esm",
    "example": "npm run build && cd ../../samples/js && npm install && npm run build && npx serve .",
    "lint": "npm run tslint",
    "lint-fix": "npm run tslint-fix",
    "tslint": "eslint . --ext .js,.mjs,.ts",
    "tslint-fix": "eslint . --ext .js,.mjs,.ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vonage/vonage-video-api-network-test.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "keywords": [
    "vonage",
    "video",
    "network test",
    "connectivity",
    "webrtc"
  ],
  "author": {
    "name": "Vonage Video API",
    "email": "support@api.vonage.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Vonage/vonage-video-api-network-test/issues"
  },
  "homepage": "https://github.com/Vonage/vonage-video-api-network-test#readme",
  "dependencies": {
    "axios": "^1.19.0",
    "@opentok/opentok-solutions-logging": "^1.1.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "@vonage/client-sdk-video": "^2.35.3",
    "@vonage/server-sdk": "^3.30.1",
    "dotenv": "^17.0.0",
    "eslint": "^8.44.0",
    "jasmine": "^6.0.0",
    "jasmine-core": "^6.0.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-cli": "^2.0.0",
    "karma-firefox-launcher": "^2.1.2",
    "karma-jasmine": "^5.1.0",
    "karma-mocha-reporter": "^2.2.5",
    "karma-safari-launcher": "^1.0.0",
    "karma-safaritechpreview-launcher": "2.0.2",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-webpack": "^5.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "ts-loader": "^9.5.1",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.0"
  },
  "overrides": {
    "js-yaml": ">=4.3.0",
    "ws": ">=8.21.0"
  }
}
